<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="TDSMAN.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <connectionStrings>
    <add name="TDSMAN.Properties.Settings.TDSMANConnectionString" connectionString="Provider=Microsoft.Jet.OLEDB.4.0;Data Source=|DataDirectory|\TDSMAN.MDB;Persist Security Info=True" providerName="System.Data.OleDb" />
    <add name="TDSMAN.Properties.Settings.TDSMANConnectionString_SS" connectionString="Data Source=TDSMAN\SQLEXPRESS;Initial Catalog=TDSMAN;User ID=sa;Password=Password123" providerName="System.Data.SqlClient" />
    <add name="TDSMAN.Properties.Settings.TDSMANConnectionString_MSACCESS" connectionString="Provider=Microsoft.Jet.OLEDB.4.0;Data Source=|DataDirectory|\bin\Debug\TDSMAN.MDB;Persist Security Info=True;Jet OLEDB:Database Password=mother" providerName="System.Data.OleDb" />
  </connectionStrings>
  <applicationSettings>
    <TDSMAN.Properties.Settings>
      <setting name="TDSMAN_TDSMAN_WEB_Registration" serializeAs="String">
        <value>http://www.tdsman.com/registration.asmx</value>
      </setting>
    </TDSMAN.Properties.Settings>
  </applicationSettings>
  <system.net>
    <settings>
      <servicePointManager expect100Continue="true" />
    </settings>
  </system.net>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
